{
  "info": {
    "name": "moneylog-api",
    "description": "登録はform-data、更新はJSONです。登録後、変数expenseIdに返されたIDを設定してください。更新・削除の対象IDを確認してから送信してください。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "expenseId", "value": "" }
  ],
  "item": [
    { "name": "全件取得", "request": { "method": "GET", "url": "{{baseUrl}}/api/expenses" } },
    {
      "name": "登録（form-data）",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/expenses",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "title", "value": "Java参考書", "type": "text" },
            { "key": "amount", "value": "2800", "type": "text" },
            { "key": "expenseDate", "value": "2026-10-20", "type": "text" },
            { "key": "category", "value": "EDUCATION", "type": "text" },
            { "key": "paymentMethod", "value": "CREDIT_CARD", "type": "text" },
            { "key": "memo", "value": "勉強用", "type": "text" }
          ]
        }
      }
    },
    { "name": "1件取得", "request": { "method": "GET", "url": "{{baseUrl}}/api/expenses/{{expenseId}}" } },
    {
      "name": "更新（JSON）",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/expenses/{{expenseId}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Java参考書（改訂版）\",\n  \"amount\": 3200,\n  \"category\": \"EDUCATION\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"expenseDate\": \"2026-10-20\",\n  \"memo\": \"金額を修正\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    { "name": "削除（対象IDを確認）", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/expenses/{{expenseId}}" } }
  ]
}
